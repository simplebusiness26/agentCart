{
  "name": "agentcart",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npx wrangler@4.129.0 dev",
    "deploy": "npx wrangler@4.129.0 deploy",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate:local": "npx wrangler@4.129.0 d1 migrations apply agentcart --local",
    "db:migrate:remote": "npx wrangler@4.129.0 d1 migrations apply agentcart --remote",
    "shopify": "npx @shopify/cli@4.7.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260903.1",
    "@types/node": "22.20.2",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
