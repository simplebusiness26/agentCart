{
  "name": "agentcart",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 migrations apply agentcart --local",
    "db:migrate:remote": "wrangler d1 migrations apply agentcart --remote",
    "shopify": "shopify"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260903.1",
    "@shopify/cli": "^4.7.1",
    "@shopify/web-pixels-extension": "^2.0.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.129.0"
  }
}
